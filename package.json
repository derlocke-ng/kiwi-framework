{
  "name": "kiwi-framework",
  "version": "0.6.2",
  "description": "The engine and the parts of a federated community hub on nostr: identity and accounts, relays, store and sync, settings, people, moderation, the design kit, the app shell, build and scaffolding. A distribution adds its name, relays and apps.",
  "license": "GPL-3.0-or-later",
  "repository": "github:derlocke-ng/kiwi-framework",
  "homepage": "https://kiwi-network.eu",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs _site",
    "relay:nostr": "node scripts/nostr-relay.mjs 7777 .nostr",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:smoke": "sh test/smoke.sh",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test:e2e": "node test/e2e/widgets.mjs && node test/e2e/boards.mjs && node test/e2e/notices.mjs && node test/e2e/payload.mjs && node test/e2e/pong.mjs",
    "probe": "node scripts/blossom-probe.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "3.4.16",
    "esbuild": "^0.28.2",
    "gun": "0.2020.1241",
    "lucide-static": "1.52.0",
    "marked": "18.1.0",
    "playwright-core": "1.63.0",
    "qrcode-generator": "2.0.4",
    "typescript": "^5.9.3"
  },
  "files": [
    "shared",
    "hub",
    "ui",
    "apps",
    "scripts",
    "test/e2e",
    "docs",
    "tsconfig.json",
    "kiwi.manifest",
    "README.md",
    "LICENSE"
  ]
}
