  "repository": "github:derlocke-ng/kiwi-framework",
  "homepage": "https://kiwi-network.eu",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/build-site.mjs",
    "serve": "node scripts/serve.mjs _site",
    "relay:nostr": "node scripts/nostr-relay.mjs 7777 .nostr",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:smoke": "sh test/smoke.sh"
  },
  "dependencies": {
    "nostr-tools": "^2.25.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gun": "0.2020.1241",
