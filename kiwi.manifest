# kiwi.manifest: what this repository is, for the Kiwi Network web catalog
# (https://github.com/derlocke-ng/kiwi-web-catalog). Same convention as the
# desktop apps' manifests; CATEGORY says what the entry is.
NAME=kiwi-framework
DESCRIPTION=The engine and the parts of a federated community hub on nostr; a distribution adds its name, relays and apps
VERSION=0.6.0
CATEGORY=Framework
COMPONENTS=web
TAGS=nostr framework hub pwa
HOMEPAGE=https://github.com/derlocke-ng/kiwi-framework
LICENSE=GPL-3.0-or-later
