{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["ui/**", "hub/**/*.ts", "hub/**/*.tsx", "scripts/vite-site.mjs", "scripts/dev.mjs"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "security": { "noDangerouslySetInnerHtml": "off" },
      "suspicious": { "noExplicitAny": "off" },
      "a11y": { "noLabelWithoutControl": "off", "useSemanticElements": "off", "noStaticElementInteractions": "off", "useKeyWithClickEvents": "off" }
    }
  }
}
